generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Payment {
  id              String   @id @default(cuid())
  appointmentUid String   @unique
  title           String
  clientName      String?
  service         String?
  startAt         DateTime
  endAt           DateTime
  amount          Int
  method          String
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
