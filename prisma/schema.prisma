generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BookingSource {
  INTERNAL
  CALENDLY
  ADMIN
}

model AvailabilitySlot {
  id        String    @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean   @default(true)
  capacity  Int       @default(1)
  notes     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startAt])
  @@index([isActive, startAt])
}

model Booking {
  id                 String            @id @default(cuid())
  availabilitySlotId String?
  availabilitySlot   AvailabilitySlot? @relation(fields: [availabilitySlotId], references: [id], onDelete: SetNull)
  source             BookingSource     @default(INTERNAL)
  status             BookingStatus     @default(PENDING)
  clientFirstName    String?
  clientLastName     String?
  clientName         String
  clientEmail        String
  clientPhone        String?
  service            String?
  startAt            DateTime
  endAt              DateTime
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([availabilitySlotId])
  @@index([source, startAt])
  @@index([status, startAt])
  @@index([clientEmail])
}

model Payment {
  id                 String   @id @default(cuid())
  appointmentUid     String   @unique
  calendlyEventUri   String?
  calendlyInviteeUri String?
  title              String
  clientFirstName    String?
  clientLastName     String?
  clientName         String?
  clientEmail        String?
  clientPhone        String?
  service            String?
  startAt            DateTime
  endAt              DateTime
  amount             Int
  method             String
  paidAt             DateTime @default(now())
  invoice            Invoice?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Invoice {
  id String @id @default(cuid())

  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  number    String
  issueDate DateTime

  sellerName    String
  sellerAddress String
  sellerSiret   String
  sellerPhone   String?
  sellerEmail   String?

  clientFirstName String
  clientLastName  String
  clientName      String
  clientEmail     String?
  clientPhone     String?

  service     String
  serviceDate DateTime
  amount      Int
  method      String

  vatMention String @default("TVA non applicable, art. 293 B du CGI")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([number])
  @@index([issueDate])
}
